# Backend: "sqlite" (local) or "databricks"
TRENDSCOPE_BACKEND=sqlite
TRENDSCOPE_SQLITE_PATH=data/trendscope.db

# Databricks SQL warehouse connection (only needed when TRENDSCOPE_BACKEND=databricks)
DATABRICKS_SERVER_HOSTNAME=adb-xxxxxxxxxxxx.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxx
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=trendscope

# Where dashboards / CSV exports are written
TRENDSCOPE_OUTPUT_DIR=output
